<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xfc="http://xoev.de/schemata/xfall/3_0/container" xmlns:xoev-dt="http://xoev.de/schemata/basisdatentypen/1_0" targetNamespace="http://xoev.de/schemata/xfall/3_0/container" version="3.0.0" elementFormDefault="qualified" attributeFormDefault="unqualified">
  <xs:annotation>
    <xs:documentation>Sammlung aller fachlichen Typen z.B. zur Wiederverwendung in den Nachrichten der unterschiedlichen Hauptgruppen.</xs:documentation>
  </xs:annotation>
  <xs:include schemaLocation="xfallcontainer-basistypen.xsd" />
