  <xs:complexType name="Gewerbetaetigkeit">
    <xs:annotation>
      <xs:documentation>Tätigkeit(en), die das Gewerbe ausführt. Die Haupttätigkeit wird mit dem Boolean Schwerpunkt versehen.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="taetigkeit" minOccurs="0" type="xoev-lc:String.Latin">
        <xs:annotation>
          <xs:documentation>genau angegebenen Tätigkeit, Arbeit die das angemeldete Gewerbe ausführt z.B. : Herstellung von Möbeln, Elektroinstallation und Elektroeinzelhandel, Großhandel mit Lebensmittel usw.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="wzschluessel" minOccurs="0" type="xoev-lc:String.Latin">
        <xs:annotation>
          <xs:documentation>Wirtschaftszweigschüssel, Branchenschlüssel. Klassifikation der Wirtschaftszweige in Gruppen von Unternehmen, die nah verwandte Substitute herstellen.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="nebenerwerb" minOccurs="0" type="xs:boolean">
        <xs:annotation>
          <xs:documentation>Wird die Tätigkeit (vorerst) im Nebenbetrieb betrieben. Ja / Nein</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="datum" minOccurs="0" type="xs:date">
        <xs:annotation>
          <xs:documentation>Datum des Beginns der angemeldeten Tätigkeit, Datum der Änderung, Datum der Betriebsaufgabe</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="schwerpunkt" minOccurs="0" type="xs:boolean">
        <xs:annotation>
          <xs:documentation>Tätigkeit ist Schwerpunkt, wenn gesetzt</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
