            <xs:annotation>
              <xs:documentation>künftige Betriebsstätte, falls an einem anderen Ort eine Neuerrichtung beabsichtigt ist</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="artDesGemeldetenBetriebs" minOccurs="0" type="xfd:Code.ArtBetrieb">
            <xs:annotation>
              <xs:documentation>Art des angemeldeten Betriebs: (Codetabelle)
Industrie, Handwerk, Handel, Sonstiges</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="beschaeftigteVollzeit" minOccurs="0" type="xs:int">
            <xs:annotation>
              <xs:documentation>Zahl der tätigen Personen im Geschäft ohne Inhaber, die Vollzeit arbeiten.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="beschaeftigteTeilzeit" minOccurs="0" type="xs:int">
            <xs:annotation>
              <xs:documentation>Zahl der tätigen Personen im Geschäft ohne Inhaber, die Teilzeit arbeiten.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="keineBeschaeftigtenPersonen" minOccurs="0" type="xs:boolean">
            <xs:annotation>
              <xs:documentation>Es arbeiten zusätzlich zum Inhaber keine weiteren Personen im Geschäft.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="meldungErstattetFuer" minOccurs="0" type="xfd:Code.ArtNiederlassung">
            <xs:annotation>
              <xs:documentation>Die Meldung wird erstattet für eine Hauptniederlassung, einen Zweigniederlassung, eine unselbständige Zweigstelle, Automatenaufstellungsgewerbe oder Reisegewerbe. (Codetabelle)</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="erlaubnis" minOccurs="0" type="xfd:Genehmigung">
            <xs:annotation>
              <xs:documentation>Falls der Betriebsinhaber für die angemeldete Tätigkeit eine Erlaubnis benötigt, in der Handwerksrolle einzutragen.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="handwerkskarte" minOccurs="0" type="xfd:Genehmigung">
            <xs:annotation>
              <xs:documentation>Falls der Betriebsinhaber für die angemeldete Tätigkeit eine Erlaubnis benötigt, in der Handwerksrolle einzutragen.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="aufenthaltsgenehmigung" minOccurs="0" type="xfd:Genehmigung">
            <xs:annotation>
              <xs:documentation>Falls der Betriebsinhaber für die angemeldete Tätigkeit eine Erlaubnis benötigt, in der Handwerksrolle einzutragen.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="auflageOderBeschraenkung" minOccurs="0" type="xfd:Genehmigung">
            <xs:annotation>
              <xs:documentation>Falls der Betriebsinhaber für die angemeldete Tätigkeit eine Erlaubnis benötigt, in der Handwerksrolle einzutragen.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
