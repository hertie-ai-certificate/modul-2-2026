      <xs:element name="selbstaendigeArbeit" minOccurs="0" type="xs:boolean">
        <xs:annotation>
          <xs:documentation>Einkünfte (positiv oder negativ) aus selbständiger Arbeit</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="gewerbebetrieb" minOccurs="0" type="xs:boolean">
        <xs:annotation>
          <xs:documentation>Einkünfte (positiv oder negativ) aus Gewerbebetrieb, z.B. auch Photovoltaik</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="landUndForstwirtschaft" minOccurs="0" type="xs:boolean">
        <xs:annotation>
          <xs:documentation>Einkünfte (positiv oder negativ) aus Land- und Forstwirtschaft</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="sonstigeEinkuenfte" minOccurs="0" type="xs:boolean">
        <xs:annotation>
          <xs:documentation>Sonstige Einnahmen, z.B. Kurzarbeitergeld, Arbeitslosengeld I</xs:documentation>
