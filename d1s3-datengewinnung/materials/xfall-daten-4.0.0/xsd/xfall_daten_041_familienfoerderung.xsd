      </xs:element>
      <xs:element name="krankenVersicherung" minOccurs="0" type="xs:boolean">
        <xs:annotation>
          <xs:documentation>Krankenversicherung der Eltern:
ja</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="krankenVersicherungPflichtversichert" minOccurs="0" type="xs:boolean">
        <xs:annotation>
          <xs:documentation>Krankenversicherung der Eltern:
ja, pflichtversichert</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="krankenVersicherungFreiwilligVersichert" minOccurs="0" type="xs:boolean">
        <xs:annotation>
          <xs:documentation>Krankenversicherung der Eltern:
ja, freiwillig versichert</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="krankenVersicherungMitversichert" minOccurs="0" type="xs:boolean">
        <xs:annotation>
          <xs:documentation>Krankenversicherung der Eltern:
ja, als Familienangehöriger mitversichert</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="krankenVersicherungBezeichnungUndSitz" minOccurs="0" type="xoev-lc:String.Latin">
        <xs:annotation>
          <xs:documentation>Krankenversicherung der Eltern:
Bezeichnung und Sitz der Krankenkasse</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="krankenVersicherungMitgliedsNummer" minOccurs="0" type="xoev-lc:String.Latin">
        <xs:annotation>
          <xs:documentation>Krankenversicherung der Eltern:
Mitglieds-Nr.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="krankenVersicherungPrivatVersichert" minOccurs="0" type="xs:boolean">
        <xs:annotation>
          <xs:documentation>Krankenversicherung der Eltern:
nein, privat versichert</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="vorGeburtEinkommen" minOccurs="0" type="xs:boolean">
        <xs:annotation>
