Einkommen aus Erwerbstätigkeit</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="vorGeburtSonstige" minOccurs="0" type="xs:boolean">
        <xs:annotation>
          <xs:documentation>Zeitraum vor der Geburt des Kindes:
Bezug von sonstigen Leistungen</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="nachGeburtKeineErwerbstaetigkeit" minOccurs="0" type="xs:boolean">
        <xs:annotation>
          <xs:documentation>Zeitraum nach der Geburt des Kindes:
keine Erwerbstätigkeit</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="nachGeburtIchNehmeElternzeit" minOccurs="0" type="xs:boolean">
        <xs:annotation>
          <xs:documentation>Zeitraum nach der Geburt des Kindes:
ich nehme Elternzeit</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="nachGeburtElternzeitZeitraum" minOccurs="0" type="xfd:Zeitraum">
        <xs:annotation>
          <xs:documentation>Zeitraum nach der Geburt des Kindes:
ich nehme Elternzeit von bis</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="nachGeburtElternzeitAbSeit" minOccurs="0" type="xs:date">
        <xs:annotation>
          <xs:documentation>Zeitraum nach der Geburt des Kindes:
ich nehme Elternzeit ab/seit</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="nachGeburtElternzeitWochenstunden" minOccurs="0" type="xs:decimal">
        <xs:annotation>
          <xs:documentation>Zeitraum nach der Geburt des Kindes:
ich nehme Elternzeit ab/seit mit Wochenstunden</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="nachGeburtResturlaub" minOccurs="0" type="xs:boolean">
        <xs:annotation>
          <xs:documentation>Zeitraum nach der Geburt des Kindes:
Resturlaub</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="nachGeburtResturlaubAnzahlTage" minOccurs="0" type="xs:decimal">
        <xs:annotation>
