Resturlaub, Anzahl Tage</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="nachGeburtResturlaubZeitraum" minOccurs="0" type="xfd:Zeitraum">
        <xs:annotation>
          <xs:documentation>Zeitraum nach der Geburt des Kindes:
Resturlaub von bis</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="nachGeburtResturlaubAusTaetigkeitMitAnzahlWochenstunden" minOccurs="0" type="xs:decimal">
        <xs:annotation>
          <xs:documentation>Zeitraum nach der Geburt des Kindes:
der Resturlaub resultiert aus einer Tätigkeit mit dieser Anzahl Wochenstunden</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="nachGeburtBerufsbildung" minOccurs="0" type="xs:boolean">
        <xs:annotation>
          <xs:documentation>Zeitraum nach der Geburt des Kindes:
Berufsbildung</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="nachGeburtBerufsbildungVoraussBis" minOccurs="0" type="xs:date">
        <xs:annotation>
          <xs:documentation>Zeitraum nach der Geburt des Kindes:
Berufsbildung mit diesem voraussichtlichen Ende</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="nachGeburtTagespflege" minOccurs="0" type="xs:boolean">
        <xs:annotation>
          <xs:documentation>Zeitraum nach der Geburt des Kindes:
Tagespflege</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="nachGeburtTagespflegeAnzahlKinder" minOccurs="0" type="xs:integer">
        <xs:annotation>
          <xs:documentation>Zeitraum nach der Geburt des Kindes:
Tagespflege; Anzahl der Kinder</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="persoenlicheAngaben" type="xfd:NatuerlichePerson">
        <xs:annotation>
          <xs:documentation>Angaben zur Person.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="nachGeburtBezugSonstige" minOccurs="0" type="xs:boolean">
        <xs:annotation>
          <xs:documentation>Zeitraum nach der Geburt des Kindes:
Bezug von sonstigen Leistungen</xs:documentation>
        </xs:annotation>
      </xs:element>
