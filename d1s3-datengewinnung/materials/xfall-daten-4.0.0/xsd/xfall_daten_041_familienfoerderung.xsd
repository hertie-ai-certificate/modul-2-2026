<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xfd="http://xoev.de/schemata/xfall_daten/4_0_0" xmlns:xoev-lc="http://xoev.de/latinchars/1_1/datatypes" targetNamespace="http://xoev.de/schemata/xfall_daten/4_0_0" version="4.0.0" elementFormDefault="qualified" attributeFormDefault="unqualified">
  <xs:annotation>
    <xs:documentation>Das Paket Familienförderung enthält die Nachrichten zum Transport von Daten im Kontext mit der Beantragung von Elterngeld.</xs:documentation>
  </xs:annotation>
  <xs:include schemaLocation="xfall_daten_baukasten.xsd" />
  <xs:import schemaLocation="latinchars.xsd" namespace="http://xoev.de/latinchars/1_1/datatypes" />
  <xs:complexType name="Bezugszeitraum">
    <xs:annotation>
      <xs:documentation>Klasse zur Kapselung des Bezugszeitraums, Angabe in Lebensmonaten.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="vonLebensmonat" minOccurs="0" type="xs:integer">
        <xs:annotation>
          <xs:documentation>Von (Lebensmonat)</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="bisLebensmonat" type="xs:integer">
        <xs:annotation>
          <xs:documentation>Bis (Lebensmonat)</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="EinkuenfteSpezifikation">
    <xs:annotation>
      <xs:documentation>Klasse zur Kapselung der Spezifikation für Einkünfte mit Zeitraum, Betrag und Wochenstunden.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="zeitraum" minOccurs="0" type="xfd:Zeitraum">
        <xs:annotation>
          <xs:documentation>Zeitraum für die Einkünfte.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="betragEuroMonatlich" type="xs:decimal">
        <xs:annotation>
          <xs:documentation>Der durchschnittliche monatliche Betrag in Euro.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="wochenstunden" type="xs:decimal">
        <xs:annotation>
          <xs:documentation>Die Anzahl der Wochenstunden.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
