      <xs:element name="nichtselbstaendigeArbeit" minOccurs="0" type="xs:boolean">
        <xs:annotation>
          <xs:documentation>Einkünfte aus nichtselbständiger Arbeit (auch Minijob)</xs:documentation>
        </xs:annotation>
